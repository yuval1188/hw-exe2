/* ===== Ice Cream Revenue App - Stylesheet ===== */

/* Global Base */
QWidget {
    background-color: #FFF8F0;
    color: #3B2F2F;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
}

/* Main Window & Dialogs */
QMainWindow, QDialog {
    background-color: #FFF8F0;
}

/* Labels */
QLabel {
    color: #5C4033;
    font-weight: 600;
    font-size: 14px;
    background-color: transparent;
    padding: 0 8px;
}

/* Push Buttons */
QPushButton {
    background-color: #E85D75;
    color: #FFFFFF;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #D64561;
}

QPushButton:pressed {
    background-color: #B8334D;
    padding-top: 11px;
    padding-bottom: 9px;
}

QPushButton:disabled {
    background-color: #E8D5CF;
    color: #A08C85;
}

/* Matplotlib Navigation Toolbar (zoom / pan / save) */
QToolBar {
    background-color: #FFFFFF;
    border: 1px solid #F2C6CF;
    border-radius: 10px;
    padding: 4px;
    spacing: 4px;
}

QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 5px;
}

QToolButton:hover {
    background-color: #FDE7EB;
}

QToolButton:checked, QToolButton:pressed {
    background-color: #F9C9D3;
}

/* Text Browser (About window) */
QTextBrowser {
    background-color: #FFFFFF;
    color: #3B2F2F;
    border: 1px solid #F2C6CF;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
}

/* Tooltips */
QToolTip {
    background-color: #3B2F2F;
    color: #FFF8F0;
    border: none;
    border-radius: 6px;
    padding: 6px;
}

/* Scrollbars */
QScrollBar:vertical {
    background: #FDF0E6;
    width: 10px;
    margin: 2px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #E8A0AE;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #E85D75;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
